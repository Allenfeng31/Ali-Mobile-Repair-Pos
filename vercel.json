{
  "regions": [
    "syd1"
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://ali-mobile-repair-pos-tqdh.vercel.app/api/:path*"
    },
    {
      "source": "/feedback",
      "destination": "/index.html"
    },
    {
      "source": "/track-status",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}